# Banco de dados (Neon Postgres).
# A integração do Neon com a Vercel injeta essa variável automaticamente em
# produção/preview. Para rodar localmente, copie a connection string do Neon
# Console (Connection Details) para cá.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# AbacatePay (presentes)
ABACATEPAY_KEY=your-abacatepay-api-key
ABACATEPAY_WEBHOOK_SECRET=um-segredo-forte-que-voce-escolhe

# URL pública do site (usada nos redirects do checkout). Ex.: https://casamento.com
NEXT_PUBLIC_SITE_URL=https://YOUR_SITE_URL
